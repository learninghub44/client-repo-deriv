{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/((?!.*\\.(?:xml|pdf|js|css|map|png|jpg|jpeg|gif|svg|webp|ico|json|txt|woff2?|ttf|wasm|mp3|wav|ogg|m4a|mp4|webm)$).*)",
            "destination": "/index.html"
        }
    ]
}
